# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.
#
# Companion: examples/_shared/.env.example is the production-shaped template.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable the OAuth 2.0 client_credentials grant — the agent uses it to mint
# its base machine token before exchanging.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Enable RFC 8693 Token Exchange — the wire mechanism behind brokered vends
# (see docs/reference/env-vars.md row `AUTHPLANE_TOKEN_EXCHANGE_ENABLED` and
# docs/guides/upstream-providers/token-exchange-grant.md).
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# HMAC secret used by the AS to sign the `state` parameter on
# /connect/<provider> consent redirects (≥32 chars). Required as soon as any
# Broker resource exists or any connect.* key is set — see
# internal/config/selfcheck.go:178-193. We don't actually drive a browser
# through /connect in this example, but the AS validates this at boot.
# generate: openssl rand -hex 32
AUTHPLANE_CONNECT_STATE_SECRET=dev-connect-state-secret-min-32-chars

# Base URL the AS embeds in `consent_url` values when emitting
# ConsentRequiredError. Must be the public origin the user's browser would
# reach the AS at. See docs/reference/env-vars.md row
# `AUTHPLANE_CONNECT_REDIRECT_BASE_URL`.
AUTHPLANE_CONNECT_REDIRECT_BASE_URL=http://localhost:9000

# At-rest encryption for `broker_grants` is mandatory whenever any Broker
# resource is configured (selfcheck.go:99-110). aes_master reads the key
# from the env var named here; the key itself is 64 hex chars (32 bytes).
AUTHPLANE_DATA_ENCRYPTION_DRIVER=aes_master
AUTHPLANE_DATA_ENCRYPTION_KEY_ENV=AUTHPLANE_AES_MASTER_KEY
# generate: openssl rand -hex 32
AUTHPLANE_AES_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Authserver-side issuer URL. Stays on the canonical port 9000 for tier 04
# (no outbound-DPoP host-header workaround needed — this tier doesn't use
# DPoP).
AUTHPLANE_SERVER_ISSUER=http://authserver:9000

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. Never
# deploy this combination in production.
AUTHPLANE_SESSION_SECURE=true

# --- agent settings --------------------------------------------------------
# Where the agent should discover Authplane metadata + JWKS. Same as
# AUTHPLANE_SERVER_ISSUER above for consistency.
AUTHPLANE_ISSUER=http://authserver:9000

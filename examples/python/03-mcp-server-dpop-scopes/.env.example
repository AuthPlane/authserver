# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.
#
# Companion: examples/_shared/.env.example is the production-shaped template
# (empty secrets, with `openssl rand -hex 32` hints) and is intended for
# operators copying the layout into their own deployment. This file is not
# layered on top of it; it is the only .env the example consumes.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable DPoP-bound access tokens (RFC 9449). This is the differentiator for
# tier 03 — when an agent presents a DPoP proof on the token endpoint, the AS
# embeds the proof key thumbprint into the access token's `cnf.jkt` claim
# (see docs/reference/env-vars.md row `AUTHPLANE_DPOP_ENABLED`).
AUTHPLANE_DPOP_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant — required for the
# machine-to-machine flow this example demos.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the MCP server uses to
# reach the AS so that the SDK's `metadata.issuer == config.issuer` check
# passes (see python-sdk/authplane/internal/metadata.py). Tier-03 listens on
# container-port 80 (see docker-compose.yml for the rationale: an outbound-
# DPoP Host-header quirk in python-sdk 0.1.0). On the host the AS is mapped
# to `localhost:19000`.
AUTHPLANE_SERVER_ISSUER=http://authserver

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. Never deploy
# this combination in production.
AUTHPLANE_SESSION_SECURE=true

# --- mcp-server settings ---------------------------------------------------
# Where the MCP server should discover Authplane metadata + JWKS. Same as
# AUTHPLANE_SERVER_ISSUER above for consistency (and same Host-header
# rationale).
AUTHPLANE_ISSUER=http://authserver

# Public base URL the MCP server advertises (used to derive the JWT audience
# = base_url + /mcp). The verify script registers a Mint resource with this
# URI so the AS will issue tokens whose `aud` claim matches. The agent
# reaches the MCP server at `mcp-server:8080` inside the compose network;
# `localhost:8080` is the audience identifier the AS embeds in the token.
AUTHPLANE_BASE_URL=http://localhost:8080

# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable the RFC 8693 Token Exchange grant on /oauth/token. This is the core
# feature tier 04 exercises: the MCP server forwards its subject token to
# the AS with grant_type=urn:ietf:params:oauth:grant-type:token-exchange and
# the AS vends a fresh upstream provider token (or returns
# consent_required + consent_url when the user hasn't connected the provider).
# Doc anchor: docs/reference/env-vars.md → AUTHPLANE_TOKEN_EXCHANGE_ENABLED.
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant. Required so the agent can
# acquire the subject token it later passes to the Token Exchange call.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the agent uses to
# reach the AS so that the SDK's `metadata.issuer == config.issuer` check
# passes. Inside Docker the AS is reachable at `authserver:9000`; on the host
# it's at `localhost:9000` — pick the one the agent sees.
AUTHPLANE_SERVER_ISSUER=http://authserver:9000

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. The AS
# config validator refuses to start with a non-localhost issuer and
# Secure=false; setting this to true unblocks bootstrap. Never deploy this
# combination in production.
AUTHPLANE_SESSION_SECURE=true

# --- agent settings --------------------------------------------------------
# Authplane issuer URL the agent uses for RFC 8414 discovery + token requests.
AUTHPLANE_ISSUER=http://authserver:9000

# Broker resource slug the agent targets as the `resource` param of the
# Token Exchange call. The verify script registers this as a Broker resource
# backed by the github provider.
UPSTREAM_RESOURCE=github

# Broker resource URI the agent mints its subject_token against (direct-broker
# model, matching the Go and Python tier-04 examples). It is the audience of
# the client_credentials token the agent then exchanges. Minting against the
# actor-MCP Mint instead would make the AS require a fronting_links row. The
# agent's actor-MCP linkage is resolved from its client_id via
# policy.runtime.client_ids (token_exchange.go:1255), not from this audience.
BROKER_RESOURCE_URI=https://github.example.invalid

# CLIENT_ID / CLIENT_SECRET are populated by the verify script when it
# registers the OAuth client; they are not part of this template. If you run
# the agent by hand (`docker compose run --rm agent`), export them yourself.

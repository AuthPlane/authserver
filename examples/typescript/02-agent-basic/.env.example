# Example-local .env template — `make run` copies this file to .env on first
# run. The verify script reads .env to pick up AUTHPLANE_ADMIN_API_KEY so it
# can register the resource + client against the tier-01 authserver.
#
# Tier 02 depends on tier 01 being up first: bring up
# `examples/typescript/01-mcp-server-basic` with `make run` before invoking
# `make verify` here. Tier 01's authserver listens on :9000 (public) and
# :9001 (admin); the MCP server listens on :8080.

# Admin API bearer token used by verify.sh to provision the client and
# resource on the running tier-01 authserver. MUST match tier 01's
# AUTHPLANE_ADMIN_API_KEY exactly.
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# --- agent runtime settings -------------------------------------------------
# Authplane issuer URL the agent uses for RFC 8414 discovery + token requests.
# The agent container joins tier-01's compose network, so it resolves the
# AS by its service name. The SDK validates that the discovered metadata's
# `issuer` field matches this URL exactly, so it must be the same value
# tier-01 was configured with (AUTHPLANE_SERVER_ISSUER in tier-01 .env).
AUTHPLANE_ISSUER=http://authserver:9000

# Resource URI passed as the `resource=` token request parameter. Must match
# the URI of the Mint resource the verify script registers (and the audience
# the tier-01 MCP server validates against). This is a logical identifier,
# not a network address — keep it on `localhost` even though the agent
# reaches the MCP server by its service name.
AUTHPLANE_RESOURCE=http://localhost:8080/mcp

# Optional override for the MCP server URL the agent calls. Defaults to
# http://mcp-server:8080/mcp (tier-01's compose service name).
# MCP_URL=http://mcp-server:8080/mcp

# Optional override for the text the echo tool should bounce back.
# ECHO_TEXT=hello from tier 02

# CLIENT_ID / CLIENT_SECRET are populated by the verify script when it
# registers the OAuth client; they are not part of this template. If you run
# the agent by hand (`docker compose run --rm agent`), export them yourself.

# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.
#
# Companion: examples/_shared/.env.example is the production-shaped template
# (empty secrets, with `openssl rand -hex 32` hints) and is intended for
# operators copying the layout into their own deployment. This file is not
# layered on top of it; it is the only .env the example consumes.
#
# -----------------------------------------------------------------------------
# Two processes share this .env. Mental model: "announce" vs "discover".
#
#   * AUTHPLANE_SERVER_ISSUER — the AS process **announces** this URL in
#     its metadata document and bakes it into every JWT's `iss` claim.
#   * AUTHPLANE_ISSUER — the SDK in your MCP server **discovers** the
#     AS at this URL and validates `metadata.issuer == config.issuer`.
#
# Both must resolve to the same hostname — usually the docker network
# name (`authserver`) or `localhost`, depending on where the MCP server
# runs. AUTHPLANE_BASE_URL is the MCP server's own public URL, used to
# derive the JWT audience (`base_url + /mcp`).
#
# The AUTHPLANE_SERVER_* family configures the AS's behaviour (grant
# enables, session secret, ...). The AUTHPLANE_* family configures the
# SDK inside your MCP server.
# -----------------------------------------------------------------------------
#
# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable DPoP-bound access tokens (RFC 9449). Required for the agent flows
# demoed by the examples.
AUTHPLANE_DPOP_ENABLED=true

# Enable RFC 8693 OAuth 2.0 Token Exchange. Required for the broker /
# cross-resource example flows.
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant. Required for the
# machine-to-machine example flows.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the MCP server uses to
# reach the AS so that the SDK's `metadata.issuer == config.issuer` check
# passes.
#   * `make run`        (native, default)    → http://localhost:9000
#   * `make docker-run` (all-in-containers)  → http://authserver:9000  (also requires AUTHPLANE_SESSION_SECURE=true)
AUTHPLANE_SERVER_ISSUER=http://localhost:9000

# Only needed when AUTHPLANE_SERVER_ISSUER is non-localhost (i.e. docker-run flow).
#AUTHPLANE_SESSION_SECURE=true

# --- mcp-server settings ---------------------------------------------------
# Where the MCP server should discover Authplane metadata + JWKS. Same as
# AUTHPLANE_SERVER_ISSUER above.
AUTHPLANE_ISSUER=http://localhost:9000

# AUTHPLANE_RESOURCE is set by the Makefile to `http://localhost:${MCP_PORT}/mcp`
# (default port 8080). It's both the JWT `aud` claim the verifier requires and
# the path the Protected Resource Metadata document is served from.

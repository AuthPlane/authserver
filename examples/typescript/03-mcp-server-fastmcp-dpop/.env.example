# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.
#
# Companion: examples/_shared/.env.example is the production-shaped template
# (empty secrets, with `openssl rand -hex 32` hints) and is intended for
# operators copying the layout into their own deployment. This file is not
# layered on top of it; it is the only .env the example consumes.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable DPoP-bound access tokens (RFC 9449). This is the core feature tier
# 03 exercises: the AS binds the issued token to the client's DPoP key via
# the `cnf.jkt` claim, and the FastMCP server verifies every request carries
# a fresh DPoP proof signed by that key.
# Doc anchor: docs/reference/env-vars.md → AUTHPLANE_DPOP_ENABLED.
AUTHPLANE_DPOP_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant. Required for the
# machine-to-machine agent flow exercised by this example.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the MCP server uses to
# reach the AS so that the SDK's `metadata.issuer == config.issuer` check
# passes. Inside Docker the AS is reachable at `authserver:9000`; on the host
# it's at `localhost:9000` — pick the one the MCP server sees.
AUTHPLANE_SERVER_ISSUER=http://authserver:9000

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. The AS
# config validator refuses to start with a non-localhost issuer and
# Secure=false; setting this to true unblocks bootstrap. Never deploy this
# combination in production.
AUTHPLANE_SESSION_SECURE=true

# --- mcp-server settings ---------------------------------------------------
# Where the FastMCP server should discover Authplane metadata + JWKS. Same
# as AUTHPLANE_SERVER_ISSUER above for consistency.
AUTHPLANE_ISSUER=http://authserver:9000

# The FastMCP server's own resource URI — used both as the JWT `aud` claim
# and as the path the Protected Resource Metadata document is served from.
# The verify script registers a Mint resource with this URI so the AS will
# issue tokens whose `aud` claim matches.
AUTHPLANE_RESOURCE=http://localhost:8080/mcp

# --- agent settings --------------------------------------------------------
# Optional override for the MCP server URL the agent calls. Defaults to
# http://mcp-server:8080/mcp (this compose project's service name).
# MCP_URL=http://mcp-server:8080/mcp

# Optional override for the text the echo tool should bounce back.
# ECHO_TEXT=hello from tier 03

# CLIENT_ID / CLIENT_SECRET are populated by the verify script when it
# registers the OAuth client; they are not part of this template. If you run
# the agent by hand (`docker compose run --rm agent`), export them yourself.

# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable DPoP-bound access tokens (RFC 9449). Required by this tier — the agent
# requests sender-constrained tokens and the AS sets the `cnf.jkt` claim only
# when this is true.
AUTHPLANE_DPOP_ENABLED=true

# Enable RFC 8693 OAuth 2.0 Token Exchange. Required for broker/cross-resource
# flows; left on here so the same AS image works across tiers.
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant. Required for this example.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the MCP server uses to
# reach the AS so that the SDK's `metadata.issuer == config.issuer` check
# passes.
#   * `make run`        (native, default)    → http://localhost:9000
#   * `make docker-run` (all-in-containers)  → http://authserver:9000  (also requires AUTHPLANE_SESSION_SECURE=true)
AUTHPLANE_SERVER_ISSUER=http://localhost:9000

# Only needed when AUTHPLANE_SERVER_ISSUER is non-localhost (i.e. docker-run flow).
# Leave commented for the native flow; uncomment for docker-run.
#AUTHPLANE_SESSION_SECURE=true

# --- mcp-server settings ---------------------------------------------------
# Where the MCP server discovers Authplane metadata + JWKS. The Go SDK adapter
# reads this via os.Getenv("AUTHPLANE_ISSUER"). In the native flow the MCP
# server and the agent both run on the host and reach the AS at the same
# localhost URL as AUTHPLANE_SERVER_ISSUER above.
AUTHPLANE_ISSUER=http://localhost:9000

# Full Resource URI the MCP server identifies as — also the JWT `aud` claim
# the verifier requires. The verify script registers a Mint resource with this
# exact URI so the AS will issue tokens whose audience matches.
AUTHPLANE_RESOURCE=http://localhost:8080/mcp

# --- agent settings --------------------------------------------------------
# The agent runs on the host (via `go run ./agent`) and reads AUTHPLANE_ISSUER
# above — in the native flow that is already the host-visible localhost URL,
# so no swap is needed.

# Relaxes the Go SDK's SSRF/HTTPS guard so the agent can fetch metadata from
# the local HTTP issuer. The MCP server passes `DevMode: true` in its adapter
# options; the agent talks to the core SDK directly (no MCP adapter), so it
# picks up dev-mode via this env var instead. Never set this in production —
# production issuers must be HTTPS and this var unset.
AUTHPLANE_DEV_MODE=1

# OAuth client credentials. Populate these from the `client_id` /
# `client_secret` printed by `make verify` — that step registers a
# `client_credentials` client with grant_types=[client_credentials] and
# authorizes it as the runtime actor for the Mint resource above. The values
# below are placeholders; the verify pipeline will fail with `invalid_client`
# until you replace them.
AUTHPLANE_CLIENT_ID=replace-with-client-id-from-make-verify
AUTHPLANE_CLIENT_SECRET=replace-with-client-secret-from-make-verify

# Tier-03 MCP server endpoint the agent calls with the DPoP-bound token.
MCP_URL=http://localhost:8080/mcp

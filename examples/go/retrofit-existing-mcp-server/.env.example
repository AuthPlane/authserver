# Retrofit example .env — copied to .env on first `make run`.
#
# DEFAULTS BELOW are for the native flow (`make run`): the AS runs in a
# container, the two MCP servers run as plain Go processes on the host.
# Both sides see the issuer as `http://localhost:9000`.
#
# If you switch to the all-in-Docker flow (`make docker-run`), edit the two
# issuer URLs to `http://authserver:9000` so the SDK inside the after-server
# container resolves the AS through the compose network. The host-side
# topology is the common retrofit path; the docker-compose path is shown
# for completeness.

# Admin API bearer + session secret (regenerate before non-local use):
#   openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Grant enables. The verify script uses client_credentials.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true
AUTHPLANE_DPOP_ENABLED=true
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Two issuer URLs that MUST share the same hostname.
#   * AUTHPLANE_SERVER_ISSUER  — read by the AS at boot.
#   * AUTHPLANE_ISSUER         — read by the Authplane SDK inside `after/`.
# For `make docker-run` change both to `http://authserver:9000`.
AUTHPLANE_SERVER_ISSUER=http://localhost:9000
AUTHPLANE_ISSUER=http://localhost:9000

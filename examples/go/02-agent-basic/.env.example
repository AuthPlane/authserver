# Example-local .env template — `make run` copies this file to .env on first
# run. The agent reads values from os.Getenv directly (no compose service for
# the agent itself); the values below mirror the tier-01 `.env.example` so the
# agent can call the tier-01 MCP server with a token minted from the same AS.
#
# Companion: examples/_shared/.env.example is the production-shaped template
# (empty secrets, with `openssl rand -hex 32` hints) and is intended for
# operators copying the layout into their own deployment. This file is not
# layered on top of it; it is the only .env the example consumes.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable DPoP-bound access tokens (RFC 9449). Required for the agent flows
# demoed by the examples.
AUTHPLANE_DPOP_ENABLED=true

# Enable RFC 8693 OAuth 2.0 Token Exchange. Required for the broker /
# cross-resource example flows.
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Enable the OAuth 2.0 client_credentials grant. Required for this example.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Authserver-side issuer URL. Must match the hostname the agent uses to reach
# the AS so that the SDK's `metadata.issuer == config.issuer` check passes.
# Inside Docker the AS is reachable at `authserver:9000`; on the host it's at
# `localhost:9000` — pick the one the agent (running on the host) sees.
AUTHPLANE_SERVER_ISSUER=http://localhost:9000

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. The AS
# config validator refuses to start with a non-localhost issuer and
# Secure=false; setting this to true unblocks bootstrap. Never deploy this
# combination in production.
AUTHPLANE_SESSION_SECURE=true

# --- agent settings --------------------------------------------------------
# Where the agent discovers Authplane metadata + JWKS. The Go SDK reads this
# via os.Getenv("AUTHPLANE_ISSUER") in main.go. Same hostname as
# AUTHPLANE_SERVER_ISSUER above so the SDK's issuer-equality check passes.
AUTHPLANE_ISSUER=http://localhost:9000

# Target Resource URI — also the `aud` claim of the minted token. Must match
# the Mint resource registered against the AS in tier-01 (`make verify` in
# `../01-mcp-server-basic/` registers exactly this URI).
AUTHPLANE_RESOURCE=http://localhost:8080/mcp

# OAuth client credentials. Populate these from the `client_id` / `client_secret`
# printed by `cd ../01-mcp-server-basic && make verify` — that step registers
# a `client_credentials` client and authorizes it as the runtime actor for the
# Mint resource above. The values below are placeholders; the verify pipeline
# below will fail with "invalid_client" if you do not replace them.
AUTHPLANE_CLIENT_ID=replace-with-client-id-from-tier-01
AUTHPLANE_CLIENT_SECRET=replace-with-client-secret-from-tier-01

# Tier-01 MCP server endpoint the agent calls with the bearer token.
MCP_URL=http://localhost:8080/mcp

# Example-local .env template — `make run` copies this file to .env on first
# run, then docker-compose loads it via `env_file: [.env]`. Pre-populated with
# dev-only placeholder values so the example works out of the box; regenerate
# the secrets before using on a non-local machine.

# Admin API bearer token for the privileged admin surface (:9001).
# generate: openssl rand -hex 32
AUTHPLANE_ADMIN_API_KEY=dev-admin-key-change-me

# Symmetric secret used to sign session cookies.
# generate: openssl rand -hex 32
AUTHPLANE_SESSION_SECRET=dev-session-secret-change-me

# Enable RFC 8693 OAuth 2.0 Token Exchange. REQUIRED for this tier — the
# broker flow is entirely a token-exchange grant against the AS.
AUTHPLANE_TOKEN_EXCHANGE_ENABLED=true

# Enable the client_credentials grant. The acting client uses it to mint
# the subject_token the agent then exchanges; without this the AS rejects
# the /admin/clients call with `grant_type "client_credentials" is not
# enabled on this server`. Python tier-04 sets the same flag — same reason.
AUTHPLANE_CLIENT_CREDENTIALS_ENABLED=true

# Tune the token-exchange knobs. Defaults are conservative; see
# docs/guides/upstream-providers/token-exchange-grant.md for the full table.
AUTHPLANE_TOKEN_EXCHANGE_MAX_CHAIN_DEPTH=4
AUTHPLANE_TOKEN_EXCHANGE_TOKEN_EXPIRY=1h
AUTHPLANE_TOKEN_EXCHANGE_ALLOW_SELF_EXCHANGE=false

# Required when issuer is non-localhost. We're on HTTP for local dev so this
# flag is informational only — cookies still go over plain HTTP. The AS
# config validator refuses to start with a non-localhost issuer and
# Secure=false; setting this to true unblocks bootstrap. Never deploy this
# combination in production.
AUTHPLANE_SESSION_SECURE=true

# Authserver-side issuer URL. The agent in this example runs on the host via
# `go run ./` (see Makefile), so the issuer must be the host-visible URL:
# host-side discovery would fail OIDC's issuer/URL match check otherwise
# (Python/TypeScript tier-04 run the agent inside the compose network and
# can therefore use the `authserver:9000` alias — see those examples).
AUTHPLANE_SERVER_ISSUER=http://localhost:9000
AUTHPLANE_ISSUER=http://localhost:9000

# --- broker provider & resource (the upstream this tier targets) -----------
# This example uses GitHub as the canonical upstream provider; swap the slug
# + endpoints if you target Google/Slack/Notion/Linear/Atlassian (see
# docs/guides/upstream-providers/connecting-providers.md Step 2 table).
BROKER_PROVIDER_SLUG=github
BROKER_RESOURCE_SLUG=github

# The upstream OAuth-app client_id / secret obtained from the provider's
# developer console (GitHub → Settings → Developer settings → OAuth Apps).
# The AS only reads the secret via its env-var name (config_data.client_secret_env),
# so the value never appears in any config file.
CONNECTOR_GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
CONNECTOR_GITHUB_SECRET=replace-with-github-oauth-app-client-secret

# --- agent (this directory's main.go) settings -----------------------------
# Relaxes the Go SDK's SSRF/HTTPS guard so the agent can fetch metadata from
# the local HTTP issuer. Other Go tiers pass `DevMode: true` in the MCP
# adapter options; tier 04 talks to the core SDK directly (no MCP adapter),
# so it picks up dev-mode via this env var instead. Never set this in
# production — production issuers must be HTTPS and this var unset.
AUTHPLANE_DEV_MODE=1

# OAuth client credentials for the AGENT performing the token exchange. The
# verify script registers a confidential client with
# grant_types=[urn:ietf:params:oauth:grant-type:token-exchange] and prints
# them back into this file. The placeholders below fail with `invalid_client`
# until the verify pipeline rewrites them.
AUTHPLANE_CLIENT_ID=replace-with-client-id-from-make-verify
AUTHPLANE_CLIENT_SECRET=replace-with-client-secret-from-make-verify

# The subject_token the agent presents — a user-issued access token from the
# AS. In a real deployment the MCP server forwards the user's token verbatim;
# here the verify script mints a client_credentials stand-in against the
# acting client (see scripts/verify.sh step 8) and rewrites this line.
AUTHPLANE_USER_ACCESS_TOKEN=replace-with-user-access-token-from-make-verify

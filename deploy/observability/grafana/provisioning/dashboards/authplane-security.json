      "id": 9,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (reason) (rate(authplane_token_exchange_denied_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "title": "Token Exchange Denied by Reason",

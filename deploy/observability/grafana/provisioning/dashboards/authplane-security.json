        "defaults": { "custom": { "fillOpacity": 20 }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (reason) (rate(authplane_client_credentials_denied_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "title": "Client Creds Denied by Reason",

  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "definition": "label_values(authserver_http_requests_total, job)",
        "includeAll": true,
        "multi": false,
        "name": "job",
        "query": { "qryType": 1, "query": "label_values(authserver_http_requests_total, job)" },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Authplane Security",
  "uid": "authplane-security"
}

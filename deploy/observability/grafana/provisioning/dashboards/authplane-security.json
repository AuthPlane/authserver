{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "Overview", "type": "link", "url": "/d/authplane-overview/authplane-overview", "icon": "apps" },
    { "title": "Operations", "type": "link", "url": "/d/authplane-operations/authplane-operations", "icon": "cog" }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Critical Alerts",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(authserver_refresh_token_reuse_total{job=~\"$job\"}[5m]))", "legendFormat": "Reuse Events", "refId": "A" }
      ],
      "title": "Refresh Token Reuse (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(authplane_dpop_proofs_rejected_total{job=~\"$job\"}[5m]))", "legendFormat": "DPoP Rejected", "refId": "A" }
      ],
      "title": "DPoP Rejected (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(authplane_token_exchange_denied_total{job=~\"$job\"}[5m]))", "legendFormat": "Exchange Denied", "refId": "A" }
      ],
      "title": "Token Exchange Denied (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(authplane_client_credentials_denied_total{job=~\"$job\"}[5m]))", "legendFormat": "Creds Denied", "refId": "A" }
      ],
      "title": "Client Creds Denied (5m)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "DPoP (RFC 9449)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15 }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(authplane_dpop_proofs_validated_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "Validated", "refId": "A" },
        { "expr": "sum(rate(authplane_dpop_proofs_rejected_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "Rejected", "refId": "B" }
      ],
      "title": "DPoP Validation Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (reason) (rate(authplane_dpop_proofs_rejected_total{job=~\"$job\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "title": "DPoP Rejection by Reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["sum"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(increase(authplane_dpop_proofs_validated_total{job=~\"$job\",result=\"valid\"}[$__range]))", "legendFormat": "Valid", "refId": "A" },
        { "expr": "sum(increase(authplane_dpop_proofs_rejected_total{job=~\"$job\"}[$__range]))", "legendFormat": "Rejected", "refId": "B" }
      ],
      "title": "DPoP: Valid vs Rejected",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Token Exchange & Client Credentials",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } }, "unit": "ops" },
        "overrides": []

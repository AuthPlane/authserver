# Round-robin load balancer for the Postgres multi-instance load test.
#
# `dynamic a` re-resolves the `authserver` Compose service name against Docker's
# embedded DNS (127.0.0.11), which returns one A record per running replica, and
# load-balances across them. `refresh` re-resolves periodically so scaling up
# (`--scale authserver=N`) is picked up without restarting Caddy.
{
	admin off
	auto_https off
}

:80 {
	reverse_proxy {
		dynamic a {
			name authserver
			port 9000
			refresh 2s
			resolvers 127.0.0.11
		}
		lb_policy round_robin
	}
}
